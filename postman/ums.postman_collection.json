{
  "info": {
    "name": "ums",
    "description": "Пользователи (8082, порт 8080 занят другим процессом), сообщения (8084) и подписки (8085).\n\nИмпортируйте коллекцию и окружение postman/ums.local.environment.json. Сценарий запускайте папкой через Collection Runner сверху вниз: он регистрирует producer, subscriber и guest, назначает роли и проходит ленту.\n\nБизнес-ошибки приходят с HTTP 200, код лежит в поле code. Транспортные ошибки сохраняют настоящий HTTP-статус.\n\nСессия передаётся заголовком X-Session-Id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "usersUrl", "value": "http://localhost:8082"},
    {"key": "messagesUrl", "value": "http://localhost:8084"},
    {"key": "subscribersUrl", "value": "http://localhost:8085"},
    {"key": "adminLogin", "value": "admin"},
    {"key": "adminPassword", "value": "admin12345"},
    {"key": "password", "value": "password123"},
    {"key": "adminUserId", "value": ""},
    {"key": "adminSessionId", "value": ""},
    {"key": "producerLogin", "value": ""},
    {"key": "producerUserId", "value": ""},
    {"key": "producerSessionId", "value": ""},
    {"key": "subscriberLogin", "value": ""},
    {"key": "subscriberUserId", "value": ""},
    {"key": "subscriberSessionId", "value": ""},
    {"key": "guestLogin", "value": ""},
    {"key": "guestUserId", "value": ""},
    {"key": "guestSessionId", "value": ""},
    {"key": "messageId", "value": ""}
  ],
  "item": [
    {
      "name": "Сценарий",
      "description": "Запускать сверху вниз. Первый запрос задаёт уникальные логины.",
      "item": [
        {
          "name": "01 Login admin",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-8);",
                  "function save(key, value) {",
                  "    pm.collectionVariables.set(key, value);",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "}",
                  "save('producerLogin', 'producer_' + suffix);",
                  "save('subscriberLogin', 'subscriber_' + suffix);",
                  "save('guestLogin', 'guest_' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('admin logged in', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body.sessionId).to.be.a('number');",
                  "});",
                  "pm.collectionVariables.set('adminUserId', String(body.userId));",
                  "pm.collectionVariables.set('adminSessionId', String(body.sessionId));",
                  "if (pm.environment.name) {",
                  "    pm.environment.set('adminUserId', String(body.userId));",
                  "    pm.environment.set('adminSessionId', String(body.sessionId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
            "url": "{{usersUrl}}/api/login",
            "description": "Вход администратора. Сохраняет adminUserId и adminSessionId."
          }
        },
        {
          "name": "02 Register producer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('producer created', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('producerUserId', String(body.id));",
            "if (pm.environment.name) pm.environment.set('producerUserId', String(body.id));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{producerLogin}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{producerLogin}}@twitter.local\",\n  \"name\": \"Producer\",\n  \"birthDate\": \"1995-04-12\"\n}"},
            "url": "{{usersUrl}}/api/register",
            "description": "Регистрация выдаёт роль GUEST. Ответ 201."
          }
        },
        {
          "name": "03 Register subscriber",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('subscriber created', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('subscriberUserId', String(body.id));",
            "if (pm.environment.name) pm.environment.set('subscriberUserId', String(body.id));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{subscriberLogin}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{subscriberLogin}}@twitter.local\",\n  \"name\": \"Subscriber\",\n  \"birthDate\": \"1998-09-01\"\n}"},
            "url": "{{usersUrl}}/api/register"
          }
        },
        {
          "name": "04 Register guest",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('guest created', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('guestUserId', String(body.id));",
            "if (pm.environment.name) pm.environment.set('guestUserId', String(body.id));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{guestLogin}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{guestLogin}}@twitter.local\",\n  \"name\": \"Guest\",\n  \"birthDate\": null\n}"},
            "url": "{{usersUrl}}/api/register"
          }
        },
        {
          "name": "05 Assign PRODUCER",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('producer role assigned', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().message).to.eql('role assigned');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{adminSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"role\": \"PRODUCER\"\n}"},
            "url": "{{usersUrl}}/api/users/{{producerUserId}}/roles",
            "description": "Роль назначает только ADMIN."
          }
        },
        {
          "name": "06 Assign SUBSCRIBER",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('subscriber role assigned', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().message).to.eql('role assigned');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{adminSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"role\": \"SUBSCRIBER\"\n}"},
            "url": "{{usersUrl}}/api/users/{{subscriberUserId}}/roles"
          }
        },
        {
          "name": "07 Login producer",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('producer logged in', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('producerSessionId', String(body.sessionId));",
            "if (pm.environment.name) pm.environment.set('producerSessionId', String(body.sessionId));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{producerLogin}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": "{{usersUrl}}/api/login"
          }
        },
        {
          "name": "08 Login subscriber",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('subscriber logged in', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('subscriberSessionId', String(body.sessionId));",
            "if (pm.environment.name) pm.environment.set('subscriberSessionId', String(body.sessionId));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{subscriberLogin}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": "{{usersUrl}}/api/login"
          }
        },
        {
          "name": "09 Login guest",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('guest logged in', function () { pm.response.to.have.status(200); });",
            "pm.collectionVariables.set('guestSessionId', String(body.sessionId));",
            "if (pm.environment.name) pm.environment.set('guestSessionId', String(body.sessionId));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{guestLogin}}\",\n  \"password\": \"{{password}}\"\n}"},
            "url": "{{usersUrl}}/api/login"
          }
        },
        {
          "name": "10 Resolve producer session",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('session has PRODUCER', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(body.roles).to.include('PRODUCER');",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/sessions/{{producerSessionId}}",
            "description": "Эту ручку вызывают messages и subscribers, чтобы узнать userId и роли."
          }
        },
        {
          "name": "11 Subscribe",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('subscribed', function () {",
            "    pm.response.to.have.status(201);",
            "    pm.expect(body.authors).to.include(Number(pm.collectionVariables.get('producerUserId') || pm.environment.get('producerUserId')));",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"authorId\": {{producerUserId}}\n}"},
            "url": "{{subscribersUrl}}/api/v1/subscribers"
          }
        },
        {
          "name": "12 My subscriptions",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('subscription id present', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().subscriptionId).to.be.a('number');",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}],
            "url": "{{subscribersUrl}}/api/v1/subscribers/my"
          }
        },
        {
          "name": "13 Followers",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('follower listed', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().length).to.be.above(0);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{subscribersUrl}}/api/v1/subscribers/{{producerUserId}}/followers?limit=20&offset=0"
          }
        },
        {
          "name": "14 Sets containing author",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('set exists', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().length).to.be.above(0);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{subscribersUrl}}/api/v1/subscribers/sets?author_id={{producerUserId}}"
          }
        },
        {
          "name": "15 Feed before the message",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('empty cached feed', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(body.subscriptionId).to.be.a('number');",
            "    pm.expect(body.messages).to.eql([]);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}],
            "url": "{{messagesUrl}}/api/v1/messages/feed"
          }
        },
        {
          "name": "16 Create message",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('message created', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('messageId', String(body.id));",
            "if (pm.environment.name) pm.environment.set('messageId', String(body.id));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{producerSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Концерт начнётся в 20:00\"\n}"},
            "url": "{{messagesUrl}}/api/v1/messages",
            "description": "Только PRODUCER. После записи сбрасывается кэш лент, куда входит автор."
          }
        },
        {
          "name": "17 Messages by author",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('author page', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json()[0].text).to.eql('Концерт начнётся в 20:00');",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{messagesUrl}}/api/v1/messages?author_id={{producerUserId}}&limit=20&offset=0"
          }
        },
        {
          "name": "18 Feed after the message",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('feed refreshed', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().messages[0].text).to.eql('Концерт начнётся в 20:00');",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}],
            "url": "{{messagesUrl}}/api/v1/messages/feed"
          }
        },
        {
          "name": "19 Update message",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('message updated', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().text).to.eql('Билеты закончились');",
            "});"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{producerSessionId}}"}
