            "description": "DELETE /api/v1/subscribers/{authorId}."
          }
        },
        {
          "name": "My subscriptions",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}],
