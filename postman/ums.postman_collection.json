        },
        {
          "name": "20 Guest cannot create a message",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('business 403', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().code).to.eql(403);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{guestSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"guest text\"\n}"},
            "url": "{{messagesUrl}}/api/v1/messages",
            "description": "Бизнес-ошибка: HTTP 200, code 403."
          }
        },
        {
          "name": "21 Guest cannot subscribe",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('business 403', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().code).to.eql(403);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
