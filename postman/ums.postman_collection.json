    {
      "name": "Users",
      "description": "http://localhost:8082. Отдельные ручки, переменные берутся из сценария или окружения.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{producerLogin}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{producerLogin}}@twitter.local\",\n  \"name\": \"Producer\",\n  \"birthDate\": \"1995-04-12\"\n}"},
            "url": "{{usersUrl}}/api/register",
            "description": "POST /api/register. 201. Новый пользователь получает GUEST."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"{{adminPassword}}\"\n}"},
            "url": "{{usersUrl}}/api/login",
            "description": "POST /api/login. Ответ: userId, login, email, name, birthDate, roles, sessionId, expiresAt."
          }
        },
        {
          "name": "Login invalid credentials",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('business 401', function () {",
            "    pm.response.to.have.status(200);",
            "    pm.expect(pm.response.json().code).to.eql(401);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{adminLogin}}\",\n  \"password\": \"wrong-password\"\n}"},
            "url": "{{usersUrl}}/api/login",
            "description": "Бизнес-ошибка: HTTP 200, code 401."
          }
        },
        {
          "name": "Resolve session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/sessions/{{adminSessionId}}",
            "description": "GET /api/sessions/{sessionId}. Ответ: userId и roles."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{usersUrl}}/api/sessions/{{adminSessionId}}",
            "description": "DELETE /api/sessions/{sessionId}. Закрывает сессию. Повторный resolve вернёт HTTP 200 и code 401."
          }
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/roles",
            "description": "GET /api/roles. ADMIN, PRODUCER, SUBSCRIBER, GUEST."
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/users",
            "description": "GET /api/users."
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/users/{{producerUserId}}",
            "description": "GET /api/users/{id}."
          }
        },
        {
          "name": "Replace profile",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"{{producerLogin}}\",\n  \"email\": \"{{producerLogin}}@twitter.local\",\n  \"name\": \"Producer Updated\",\n  \"birthDate\": \"1995-04-12\",\n  \"roles\": [\"PRODUCER\"]\n}"},
            "url": "{{usersUrl}}/api/users/{{producerUserId}}",
            "description": "PUT /api/users/{id}. roles обязателен и заменяет текущий набор ролей."
          }
        },
        {
          "name": "Patch profile",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Producer Patched\"\n}"},
            "url": "{{usersUrl}}/api/users/{{producerUserId}}",
            "description": "PATCH /api/users/{id}. Нужен email или name."
          }
        },
        {
          "name": "Assign role",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{adminSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"role\": \"PRODUCER\"\n}"},
            "url": "{{usersUrl}}/api/users/{{producerUserId}}/roles",
            "description": "POST /api/users/{id}/roles. Заголовок X-Session-Id администратора."
          }
        },
        {
          "name": "Last session",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{usersUrl}}/api/users/{{producerUserId}}/sessions/last",
            "description": "GET /api/users/{id}/sessions/last."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{usersUrl}}/api/users/{{guestUserId}}",
            "description": "DELETE /api/users/{id}. Удаляет пользователя guest из сценария."
          }
        }
      ]
    },
    {
      "name": "Messages",
      "description": "http://localhost:8084. Заголовок X-Session-Id нужен для создания, изменения, удаления и ленты.",
      "item": [
        {
          "name": "Create message",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{producerSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Концерт начнётся в 20:00\"\n}"},
            "url": "{{messagesUrl}}/api/v1/messages",
            "description": "POST /api/v1/messages. 201. Только PRODUCER."
          }
        },
        {
          "name": "Update message",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Session-Id", "value": "{{producerSessionId}}"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Билеты закончились\"\n}"},
            "url": "{{messagesUrl}}/api/v1/messages/{{messageId}}",
            "description": "PUT /api/v1/messages/{id}. Только автор."
          }
        },
        {
          "name": "Delete message",
          "request": {
            "method": "DELETE",
            "header": [{"key": "X-Session-Id", "value": "{{producerSessionId}}"}],
            "url": "{{messagesUrl}}/api/v1/messages/{{messageId}}",
            "description": "DELETE /api/v1/messages/{id}. Только автор."
          }
        },
        {
          "name": "Messages by author",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{messagesUrl}}/api/v1/messages?author_id={{producerUserId}}&limit=20&offset=0",
            "description": "GET /api/v1/messages?author_id=&limit=20&offset=0. limit по умолчанию 20, максимум 100."
          }
        },
        {
          "name": "Feed",
          "request": {
            "method": "GET",
            "header": [{"key": "X-Session-Id", "value": "{{subscriberSessionId}}"}],
            "url": "{{messagesUrl}}/api/v1/messages/feed?limit=20&offset=0",
            "description": "GET /api/v1/messages/feed. Сервис берёт подписку у subscribers и кэширует страницу по умолчанию как feed:{subscriptionId}."
          }
        }
      ]
    },
    {
      "name": "Subscribers",
      "description": "http://localhost:8085. Подписывается SUBSCRIBER, автор должен быть PRODUCER.",
